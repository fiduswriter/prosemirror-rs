{
  "name": "prosemirror-rs",
  "version": "0.4.1",
  "description": "Rust-powered drop-in replacement for prosemirror-model and prosemirror-transform — native addon in Node.js, WebAssembly everywhere else",
  "main": "npm/napi/index.js",
  "types": "npm/index.d.ts",
  "exports": {
    ".": {
      "node": "./npm/napi/index.js",
      "browser": "./npm/wasm/index.js",
      "default": "./npm/wasm/index.js"
    },
    "./model": {
      "node": "./npm/model.js",
      "browser": "./npm/model.js",
      "default": "./npm/model.js"
    },
    "./transform": {
      "node": "./npm/transform.js",
      "browser": "./npm/transform.js",
      "default": "./npm/transform.js"
    }
  },
  "typesVersions": {
    "*": {
      "model": ["./npm/model.d.ts"],
      "transform": ["./npm/transform.d.ts"]
    }
  },
  "files": [
    "npm/"
  ],
  "scripts": {
    "build": "cargo build --release && node copy-artifact.mjs",
    "test": "npm run build && node --test tests/*.test.js",
    "build:wasm": "cd ../wasm && wasm-pack build --target web --out-dir ../node/npm/wasm && wasm-pack build --target nodejs --out-dir ../node/npm/wasm-nodejs",
    "test:wasm": "npm run build:wasm && node --test tests/wasm-smoke.test.cjs",
    "test:upstream": "node run-upstream-tests.mjs",
    "test:all": "npm test && npm run test:upstream && npm run test:wasm"
  },
  "keywords": [
    "prosemirror",
    "prosemirror-model",
    "prosemirror-transform",
    "collaborative-editing",
    "editor",
    "document",
    "napi",
    "wasm",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fiduswriter/prosemirror-rs"
  },
  "homepage": "https://github.com/fiduswriter/prosemirror-rs#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ist": "^1.1.7",
    "mocha": "^11.7.6"
  },
  "dependencies": {
    "prosemirror-test-builder": "^1.1.1"
  }
}
